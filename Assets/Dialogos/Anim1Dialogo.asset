MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25c749f3ef0e7fc44b3f727b658fa103, type: 3}
  m_Name: Anim1Dialogo
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScriptable
  dialogues:
  - startDelay: 0
    duration: 3
    dialogue: La verdad no se para que acepte este trabajo.
  - startDelay: 1
    duration: 5
    dialogue: Subis, reactivas las antenas bajas, asi me lo vendieron, como si fuera
      cambiar una lamparita.
  - startDelay: 5
    duration: 6
    dialogue: "0 se\xF1al, hace 20 min no tengo cobertura \xEDncreible, me manda
      a arreglar unas atenas y no puedo llamar para avisar que llegue. "
  - startDelay: 4
    duration: 10
    dialogue: "Lo que me parece raro es que el equipo anterior se fue sin reportar.
      As\xED, sin m\xE1s. Cuatro tipos y ninguno mand\xF3 un informe de cierre. Eso
      me parece raro.\r\n  "
  - startDelay: 6
    duration: 2
    dialogue: "Bueno... hasta ac\xE1 llegamos.\r\n\r\n  "
  - startDelay: 1
    duration: 1
    dialogue: "Qu\xE9 ganas de no bajarme del auto.\r\n\r\n  "
